# shfmt reads this: the hooks and bin/menard are indented with two spaces, and a new script the
# hook formats follows them, not shfmt's tabs. By path, not [*.sh]: the tests' scratch scripts
# under tmp/ assert shfmt's own defaults
root = true

[{hooks,eval/pile}/*.sh]
indent_style = space
indent_size = 2

[bin/menard]
indent_style = space
indent_size = 2
