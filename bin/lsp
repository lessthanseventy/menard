#!/usr/bin/env bash
# The Elixir language server, on stdio, run from the project it serves. The one place that names
# it: the Claude Code plugin's lspServers and menard's own client (Menard.Lsp) both start this, so
# MENARD_LSP swaps it for both.
set -euo pipefail

# the server is a VM run in the project: a crash of it dumps where bin/menard's VMs do, not there
export ERL_CRASH_DUMP="${ERL_CRASH_DUMP:-${TMPDIR:-/tmp}/menard-erl_crash.dump}"

case "${MENARD_LSP:-expert}" in
  expert) exec expert --stdio ;;
  elixir-ls) exec elixir-ls ;;
  *)
    # a path: any server that speaks LSP on stdio (the tests' own, one that says what it does when)
    [[ -x "$MENARD_LSP" ]] && exec "$MENARD_LSP"
    echo "MENARD_LSP=$MENARD_LSP: not a server menard knows (expert, elixir-ls) nor a program" >&2 && exit 2
    ;;
esac
