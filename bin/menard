#!/usr/bin/env bash
# `menard VERB ARGS…` → `mix menard.VERB ARGS…` from menard's own project.
set -euo pipefail

# All of it in one group, read whole before any of it runs: bash reads a script as it goes, so
# this file edited while it ran (menard editing its own launcher, 2026-09-29) went on from the
# changed bytes ("ondition:: command not found"), after its work was done and with a failing exit.
# `--frozen` is no help there: it runs the last build of the Elixir, through this same file.
{

# mix has to run from menard's own project, so the caller's directory — what every verb resolves a
# relative path against (Menard.caller_dir/0) — rides MENARD_CWD. A mise task with `dir =` set has
# already moved us, and left the real one in MISE_ORIGINAL_CWD.
export MENARD_CWD="${MENARD_CWD:-${MISE_ORIGINAL_CWD:-$PWD}}"
# readlink: `./menard` at the root links here, and its `..` is the root's parent
cd -- "$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"

# menard runs on ITS toolchain (.tool-versions), not whatever the caller's PATH puts first: a host's
# newer Elixir rebuilt menard from scratch on every switch, and an older one cannot run it at all.
run=()
command -v mise >/dev/null 2>&1 && run=(mise exec -C "$PWD" --)

# menard building ITSELF (a first fetch, a compile after an update) is menard's business, not the
# caller's: its log goes nowhere unless it fails. stderr then carries only the verb's own refusals
# and real errors, so a caller never has to throw it away to read the answer. Every mix that is not
# the verb itself reads /dev/null: a VM left on the caller's stdin swallows what was piped to the
# verb (`write FILE -` wrote an empty file) or the MCP client's first message.
quietly() {
  local log
  log=$("$@" 2>&1 </dev/null) && return 0
  local status=$?
  printf '%s\n' "$log" >&2
  return $status
}
frozen=0
[[ "${1:-}" == "--frozen" ]] && { frozen=1; shift; }

# A VM's schedulers spin while they wait: a one-test `mix test` was 4 CPU-seconds in half a second
# of wall, every core busy, and the gate's hundreds of VMs 2,450 CPU-seconds, loading the machine
# for every session on it. Off, 0.6, the same wall. Exported, so every VM this one starts (a host's
# mix, its formatter, the suite a gate runs and the VMs it starts) has them off; the caller's own
# ERL_FLAGS come after, and win.
export ERL_FLAGS="+sbwt none +sbwtdcpu none +sbwtdio none${ERL_FLAGS:+ $ERL_FLAGS}"

# deps/ as mix.lock has them. A fresh install has none: git carries neither deps/ nor _build, and
# nothing runs `mix deps.get` for a cloned Claude Code plugin. And git does not track deps/, so a
# pull or checkout whose mix.lock gained a dep kept the old ones, and the compile died on
# "dependency not available". So fetch whenever mix.lock differs from the one last fetched for;
# mix.lock is tracked, so this resolves to the tested versions. The compile below builds them.
# Only this env's: ex_doc and its lexers are the docs env's, and cost a first start seconds.
# `--frozen` runs the last build as it is, so it fetches nothing either.
fetched=deps/.menard-mix-lock
if ((!frozen)) && ! cmp -s mix.lock "$fetched"; then
  quietly "${run[@]}" mix deps.get --only "${MIX_ENV:-dev}"
  cp mix.lock "$fetched"
fi

# this menard, by its path, in whatever it tells its caller to run: a bare `menard` is whichever one
# the caller's PATH holds first, and a plugin's bin/ is the last place the harness's shell looks
self="$PWD/bin/menard"

# every lib/mix/tasks/menard.*.ex (a test holds the two to each other)
verbs="help|edit|outline|find|deps|attr|clause|stmt|block|module|directive|rename|write|run|map|where|mcp|guard|hook|version"

verb="${1:-}"
# `--help`, and `VERB --help`: the help, of everything or of the verb
case "$verb" in --help | -h) verb=help && set -- help "${@:2}" ;; esac
case "${2:-}" in --help | -h) set -- help "$verb" && verb=help ;; esac
[[ -n "$verb" ]] || { echo "usage: $self [--frozen] VERB ARGS… [--stdin] ($verbs); $self --help says what each is for" >&2; exit 2; }
# refused here, not by mix's "task could not be found" after a compile
[[ "|$verbs|" == *"|$verb|"* ]] || { echo "menard: no verb $verb — usage: $self [--frozen] VERB ARGS… [--stdin] ($verbs); $self --help says what each is for" >&2; exit 2; }
shift

# `--stdin`: the LAST argument comes from stdin — multi-line CODE full of quotes and backslashes,
# which no shell quoting carries intact. Read here, before any mix could take stdin first.
args=()
from_stdin=0
for a in "$@"; do if [[ "$a" == "--stdin" ]]; then from_stdin=1; else args+=("$a"); fi; done
((from_stdin)) && args+=("$(cat)")
set -- ${args[@]+"${args[@]}"}

build="_build/${MIX_ENV:-dev}"
# stdout is the verb's ANSWER — one JSON line from `run`, the protocol for `mcp` — and mix prints
# "Compiling N files" to stdout, glued onto the front of it. So when anything is newer than the last
# build, compile first with the log on stderr; the verb then runs off that build (below) and never
# compiles. `--frozen` skips this: the escape hatch for editing menard WITH menard, when a
# half-applied edit (a clause calling a helper the next call is about to add) stops the project
# compiling and the tool would lock itself out of finishing its own edit.
manifest="$build/lib/menard/.mix/compile.elixir"
# where the build was made: mix's manifest holds absolute source paths, so a copy of this checkout
# (a plugin pinned elsewhere, _build and mtimes included) passes the mtime test and then rebuilt
# every file inside the verb's own mix, onto its stdout, where it read as the top of the answer
built_at="$build/.menard-built-at"
# what the build held: a dep's build gone (a `deps.clean`, another process rebuilding _build beside
# this verb) is a compile the verb would otherwise do itself, with its log on stdout
built_libs="$build/.menard-built-libs"
stale() {
  [[ -f "$manifest" ]] || return 0
  [[ "$(cat "$built_at" 2>/dev/null)" == "$PWD" ]] || return 0
  [[ -z "$(find lib mix.exs mix.lock -newer "$manifest" -print -quit 2>/dev/null)" ]] || return 0
  # a build made before this file was kept is one whose deps nobody checked
  [[ -f "$built_libs" ]] || return 0
  local ebin
  while IFS= read -r ebin; do
    [[ -z "$ebin" || -d "$ebin" ]] || return 0
  done <"$built_libs"
  return 1
}
if ((!frozen)) && stale; then
  # A failed compile has already deleted the beams of the modules it was recompiling, and
  # `--frozen` runs off exactly those: put the last good ones back, or the retry it is told to make
  # dies on "module Menard.Source is not available"
  ebin="$build/lib/menard/ebin"
  good=$(mktemp -d)
  [[ -d "$ebin" ]] && cp -a "$ebin/." "$good/"
  if ! quietly "${run[@]}" mix compile; then
    rm -rf "$ebin" && mkdir -p "$ebin" && cp -a "$good/." "$ebin/"
    rm -rf "$good"
    echo "menard: that is a compile error in menard ITSELF (a half-applied edit) — retry with: $self --frozen $verb …" >&2
    exit 1
  fi
  rm -rf "$good"
  # mix recompiles by content, this check goes by mtime: a file touched but unchanged leaves the
  # manifest old, and without this every later call would pay a compile it does not need
  touch "$manifest"
  printf '%s' "$PWD" >"$built_at"
  ls -d "$build"/lib/*/ebin >"$built_libs"
fi

# Every verb runs the LAST BUILD straight off _build, with no mix project and no compile step: the
# verb's VM never compiles, so its stdout is only its answer, and it never waits on a build lock
# another process holds. MIX_ENV's build only, as mix would run: with the docs and test builds on
# the path too, the glob's order picked which build's modules loaded. Args ride System.argv, so
# multi-line CODE with quotes in it survives.
pa=()
for ebin in "$build"/lib/*/ebin; do
  if [[ -d "$ebin" ]]; then pa+=(-pa "$PWD/$ebin"); fi
done
[[ ${#pa[@]} -gt 0 ]] || { echo "menard: nothing built yet — run a plain verb once, without --frozen" >&2; exit 2; }
# Mix.raise is how every task reports a miss ("no clause go/1 with head … — have: …"), and only
# the `mix` CLI turns that into a message; raised here it would print as a bare stack trace and
# lose the one line that tells you what to fix. The logger level is config/config.exs's, which
# only a mix project loads.
script='
  Mix.start()
  Logger.configure(level: :warning)
  [v | rest] = System.argv()
  try do
    Mix.Task.run("menard." <> v, rest)
  rescue
    e in Mix.Error ->
      IO.puts(:stderr, "** (Mix) " <> Exception.message(e))
      System.halt(1)
  end'

# `mcp` is a long-running stdio SERVER: its stdout IS the JSON-RPC channel, so nothing may buffer
# it — no capture and no wrapper, exec.
if [[ "$verb" == "mcp" ]]; then
  exec "${run[@]}" elixir "${pa[@]}" -e "$script" -- "$verb" "$@"
fi

# Only STDERR is captured, to read what went wrong: capturing stdout would buffer it until exit,
# which is fatal to anything that streams. `&& status=0 || status=$?` keeps the call in a
# condition: under `set -e` a failing verb would abort the script before the lines below.
err=$(mktemp)
trap 'rm -f "$err"' EXIT
"${run[@]}" elixir "${pa[@]}" -e "$script" -- "$verb" "$@" 2>"$err" && status=0 || status=$?
# the reader went away (`| head`): the BEAM's writer crashed on the closed stdout (:epipe) with a
# stack trace, and nothing is wrong. What was read was the answer; exit as a shell tool does.
if ((status != 0)) && grep -q "Writer crashed (:epipe)" "$err"; then
  exit 0
fi
cat "$err" >&2
exit "$status"
}
