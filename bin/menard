#!/usr/bin/env bash
# `menard VERB ARGS…` → `mix menard.VERB ARGS…` from menard's own project.
set -euo pipefail

# mix has to run from menard's own project, so the caller's directory — what every verb resolves a
# relative path against (Menard.caller_dir/0) — rides MENARD_CWD. A mise task with `dir =` set has
# already moved us, and left the real one in MISE_ORIGINAL_CWD.
export MENARD_CWD="${MENARD_CWD:-${MISE_ORIGINAL_CWD:-$PWD}}"
cd -- "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

# menard runs on ITS toolchain (.tool-versions), not whatever the caller's PATH puts first: a host's
# newer Elixir rebuilt menard from scratch on every switch, and an older one cannot run it at all.
run=()
command -v mise >/dev/null 2>&1 && run=(mise exec -C "$PWD" --)

# A fresh install has no deps/ and no _build — git carries neither, and nothing runs `mix deps.get`
# for a cloned Claude Code plugin. Without this, every verb dies on "some dependencies are missing"
# the first time anyone uses it. mix.lock is tracked, so this resolves to the tested versions.
# Output goes to STDERR: `mcp`'s stdout is the JSON-RPC channel and a fetch log there is fatal.
# Every mix that is not the verb itself reads /dev/null: a VM left on the caller's stdin swallows
# what was piped to the verb (`write FILE -` wrote an empty file) or the MCP client's first message.
if [[ ! -d deps/sourceror ]]; then
  echo "menard: first run — fetching deps" >&2
  "${run[@]}" mix deps.get >&2 </dev/null
  # Compile here too, with the log on stderr. A cold build is ~200 lines that mix writes to
  # STDOUT, and stdout is the answer: one JSON line from `run`, the protocol for `mcp`.
  "${run[@]}" mix compile >&2 </dev/null
fi

verbs="outline|find|deps|attr|clause|stmt|block|module|directive|rename|write|run|mcp"
frozen=0
[[ "${1:-}" == "--frozen" ]] && { frozen=1; shift; }

verb="${1:-}"
[[ -n "$verb" ]] || { echo "usage: menard [--frozen] VERB ARGS… [--stdin] ($verbs)" >&2; exit 2; }
shift

# `--stdin`: the LAST argument comes from stdin — multi-line CODE full of quotes and backslashes,
# which no shell quoting carries intact. Read here, before any mix could take stdin first.
args=()
from_stdin=0
for a in "$@"; do if [[ "$a" == "--stdin" ]]; then from_stdin=1; else args+=("$a"); fi; done
((from_stdin)) && args+=("$(cat)")
set -- ${args[@]+"${args[@]}"}

# --frozen runs the LAST BUILT menard straight off _build, with no compile step. The escape hatch
# for editing menard WITH menard: a half-applied edit (a clause calling a helper the next call is
# about to add) stops the project compiling, and every normal invocation compiles first — so the
# tool locks itself out of finishing its own edit. Args ride System.argv, so multi-line CODE with
# quotes in it survives.
if ((frozen)); then
  pa=()
  for ebin in _build/*/lib/*/ebin; do pa+=(-pa "$PWD/$ebin"); done
  [[ ${#pa[@]} -gt 0 ]] || { echo "menard --frozen: nothing built yet — run a plain verb once" >&2; exit 2; }
  # Mix.raise is how every task reports a miss ("no clause go/1 with head … — have: …"), and only
  # the `mix` CLI turns that into a message; raised here it would print as a bare stack trace and
  # lose the one line that tells you what to fix.
  exec "${run[@]}" elixir "${pa[@]}" -e '
    Mix.start()
    [v | rest] = System.argv()
    try do
      Mix.Task.run("menard." <> v, rest)
    rescue
      e in Mix.Error ->
        IO.puts(:stderr, "** (Mix) " <> Exception.message(e))
        System.halt(1)
    end' -- "$verb" "$@"
fi

# stdout is the verb's ANSWER — a value from `attr get`, one JSON line from `run` — and mix prints
# "Compiling N files" to stdout, glued onto the front of it. So when anything is newer than the last
# build, compile first with the log on stderr; the verb's own mix then has nothing to compile.
manifest="_build/${MIX_ENV:-dev}/lib/menard/.mix/compile.elixir"
if [[ "$verb" != "mcp" ]] &&
  { [[ ! -f "$manifest" ]] || [[ -n "$(find lib mix.exs mix.lock -newer "$manifest" -print -quit 2>/dev/null)" ]]; }; then
  if ! "${run[@]}" mix compile >&2 </dev/null; then
    echo "menard: that is a compile error in menard ITSELF (a half-applied edit) — retry with: menard --frozen $verb …" >&2
    exit 1
  fi
  # mix recompiles by content, this check goes by mtime: a file touched but unchanged leaves the
  # manifest old, and without this every later call would pay a compile it does not need
  touch "$manifest"
fi

# `mcp` is a long-running stdio SERVER: its stdout IS the JSON-RPC channel. Two rules follow.
# One: nothing may buffer it, so no capture and no wrapper — exec. Two: nothing else may write
# there, and mix's own "Compiling N files" goes to stdout, which on a cold start is dozens of
# lines straight into the protocol. Compile first with that output on stderr, so the server starts
# with a clean channel.
if [[ "$verb" == "mcp" ]]; then
  "${run[@]}" mix compile >&2 </dev/null || exit $?
  exec "${run[@]}" mix "menard.$verb" "$@"
fi

# A compile error here is usually menard's OWN source mid-edit, not the caller's target — say so,
# because the fix (--frozen) is not guessable from mix's message. Only for a compile failure: an
# ordinary miss ("no clause go/1 with head …") already says exactly what to do. Only STDERR is
# captured to test for it: capturing stdout would buffer it until exit, which is fatal to anything
# that streams.
err=$(mktemp)
trap 'rm -f "$err"' EXIT
# `&& status=0 || status=$?` keeps the call in a condition: under `set -e` a failing mix would abort
# the script before the line below prints the error, the one that says what to fix.
"${run[@]}" mix "menard.$verb" "$@" 2>"$err" && status=0 || status=$?
cat "$err" >&2
if ((status != 0)) && grep -qE "cannot compile module|CompileError" "$err"; then
  echo "menard: that is a compile error in menard ITSELF (a half-applied edit) — retry with: menard --frozen $verb …" >&2
fi
exit $status
