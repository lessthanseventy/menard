{
  "description": "Every Elixir file an edit or a shell command writes is formatted with its own project's formatter, plugins included; what the formatter changed goes back to the agent, and a file that does not parse is named. Each hook is a call to menard's hooks server already running (Menard.MCP.Hooks, apart from the verbs' so no hook waits on a run): no process is started. PreToolUse fails open after 10 s.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Agent|Task|Read",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:menard:menard-hooks",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "tool": "${tool_name}",
              "session": "${session_id}",
              "call": "${tool_use_id}",
              "cwd": "${cwd}",
              "input": "${tool_input}",
              "response": "${tool_response}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Read",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:menard:menard-hooks",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "tool": "${tool_name}",
              "session": "${session_id}",
              "call": "${tool_use_id}",
              "cwd": "${cwd}",
              "input": "${tool_input}",
              "response": "${tool_response}"
            },
            "timeout": 120,
            "statusMessage": "mix format"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:menard:menard-hooks",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "tool": "${tool_name}",
              "session": "${session_id}",
              "call": "${tool_use_id}",
              "cwd": "${cwd}",
              "input": "${tool_input}",
              "response": "${tool_response}"
            },
            "timeout": 120,
            "statusMessage": "mix format"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_menard_menard__(edit|write|rename|clause|stmt|directive|attr|block|module|deps)",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:menard:menard-hooks",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "tool": "${tool_name}",
              "session": "${session_id}",
              "call": "${tool_use_id}",
              "cwd": "${cwd}",
              "input": "${tool_input}",
              "response": "${tool_response}"
            },
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:menard:menard-hooks",
            "tool": "hook",
            "input": {
              "event": "${hook_event_name}",
              "tool": "${tool_name}",
              "session": "${session_id}",
              "call": "${tool_use_id}",
              "cwd": "${cwd}",
              "input": "${tool_input}",
              "response": "${tool_response}"
            },
            "timeout": 120,
            "statusMessage": "mix format"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
