+defmodule DeskWeb.FallbackController do
+  @moduledoc "What the API answers when a ticket is not there, or a move is not one."
+  use DeskWeb, :controller
+
+  def call(conn, {:error, :not_found}),
+    do: conn |> put_status(:not_found) |> json(%{error: "not_found"})
+
+  def call(conn, {:error, :invalid_transition}),
+    do: conn |> put_status(:unprocessable_entity) |> json(%{error: "invalid_transition"})
+end
diff --git a/lib/desk_web/controllers/ticket_controller.ex b/lib/desk_web/controllers/ticket_controller.ex
new file mode 100644
index 0000000..980f74a
--- /dev/null
+++ b/lib/desk_web/controllers/ticket_controller.ex
@@ -0,0 +1,101 @@
+defmodule DeskWeb.TicketController do
+  @moduledoc "Tickets for other systems: JSON under /api, and the CSV export."
+  use DeskWeb, :controller
+
+  action_fallback DeskWeb.FallbackController
+
+  alias Desk.Repo
+  alias Desk.Tickets
+  alias Desk.Tickets.Ticket
+
+  def index(conn, params) do
+    render(conn, :index,
+      tickets: Repo.preload(Tickets.list_tickets(narrowing(params)), :assignee)
+    )
+  end
+
+  def show(conn, %{"id" => id}) do
+    with {:ok, ticket} <- fetch(id) do
+      render(conn, :show,
+        ticket: ticket,
+        comments: Tickets.list_comments(ticket, internal: false)
+      )
+    end
+  end
+
+  def create(conn, params) do
+    case Tickets.create_ticket(Map.get(params, "ticket") || %{}) do
+      {:ok, ticket} ->
+        conn |> put_status(:created) |> render(:show, ticket: Repo.preload(ticket, :assignee))
+
+      {:error, changeset} ->
+        conn |> put_status(:unprocessable_entity) |> render(:errors, changeset: changeset)
+    end
+  end
+
+  def transition(conn, %{"id" => id} = params) do
+    with {:ok, ticket} <- fetch(id),
+         {:ok, to} <- status(params["to"]),
+         {:ok, ticket} <- Tickets.transition(ticket, to) do
+      render(conn, :show, ticket: Repo.preload(ticket, :assignee, force: true))
+    end
+  end
+
+  def export(conn, _params) do
+    rows =
+      for ticket <- Repo.preload(Tickets.list_tickets(), :assignee) do
+        [
+          ticket.id,
+          ticket.subject,
+          ticket.status,
+          ticket.priority,
+          ticket.requester_email,
+          ticket.assignee && ticket.assignee.name,
+          DateTime.to_iso8601(ticket.inserted_at)
+        ]
+      end
+
+    header = ~w(id subject status priority requester_email assignee inserted_at)
+
+    conn
+    |> put_resp_content_type("text/csv")
+    |> send_resp(200, Enum.map([header | rows], &line/1))
+  end
+
+  defp line(fields), do: [fields |> Enum.map(&field/1) |> Enum.intersperse(","), "\r\n"]
+
+  # RFC 4180: a field with a comma, a quote or a line break is quoted, its quotes doubled
+  defp field(nil), do: ""
+
+  defp field(value) do
+    text = to_string(value)
+
+    if String.contains?(text, [",", "\"", "\n", "\r"]),
+      do: ["\"", String.replace(text, "\"", "\"\""), "\""],
+      else: text
+  end
+
+  defp fetch(id) do
+    with {id, ""} <- Integer.parse(id),
+         %Ticket{} = ticket <- Repo.get(Ticket, id) do
+      {:ok, Repo.preload(ticket, :assignee)}
+    else
+      _ -> {:error, :not_found}
+    end
+  end
+
+  defp status(to) when is_binary(to) do
+    case Enum.find(Ticket.statuses(), &(Atom.to_string(&1) == to)) do
+      nil -> {:error, :invalid_transition}
+      status -> {:ok, status}
+    end
+  end
+
+  defp status(_to), do: {:error, :invalid_transition}
+
+  defp narrowing(params) do
+    for {key, values} <- [status: Ticket.statuses(), priority: Ticket.priorities()],
+        value = Enum.find(values, &(Atom.to_string(&1) == params[Atom.to_string(key)])),
+        do: {key, value}
+  end
+end
diff --git a/lib/desk_web/controllers/ticket_json.ex b/lib/desk_web/controllers/ticket_json.ex
new file mode 100644
index 0000000..dd851f2
--- /dev/null
+++ b/lib/desk_web/controllers/ticket_json.ex
@@ -0,0 +1,39 @@
+defmodule DeskWeb.TicketJSON do
+  @moduledoc "A ticket as the API gives it."
+
+  alias Desk.SLA
+
+  def index(%{tickets: tickets}), do: %{data: Enum.map(tickets, &ticket/1)}
+
+  def show(%{ticket: ticket, comments: comments}),
+    do: %{data: ticket |> ticket() |> Map.put(:comments, Enum.map(comments, &comment/1))}
+
+  def show(%{ticket: ticket}), do: %{data: ticket(ticket)}
+
+  def errors(%{changeset: changeset}) do
+    %{
+      errors:
+        Ecto.Changeset.traverse_errors(changeset, fn {message, opts} ->
+          Enum.reduce(opts, message, fn {key, value}, text ->
+            String.replace(text, "%{#{key}}", to_string(value))
+          end)
+        end)
+    }
+  end
+
+  defp ticket(ticket) do
+    %{
+      id: ticket.id,
+      subject: ticket.subject,
+      status: ticket.status,
+      priority: ticket.priority,
+      requester_email: ticket.requester_email,
+      assignee: ticket.assignee && %{id: ticket.assignee.id, name: ticket.assignee.name},
+      due_at: SLA.due_at(ticket),
+      inserted_at: ticket.inserted_at
+    }
+  end
+
+  defp comment(comment),
+    do: Map.take(comment, [:id, :author_kind, :body, :inserted_at])
+end
diff --git a/lib/desk_web/live/ticket_live/index.ex b/lib/desk_web/live/ticket_live/index.ex
