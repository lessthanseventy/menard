diff --git a/lib/desk/sla.ex b/lib/desk/sla.ex
new file mode 100644
index 0000000..2b08872
--- /dev/null
+++ b/lib/desk/sla.ex
@@ -0,0 +1,55 @@
+defmodule Desk.SLA do
+  @moduledoc """
+  When a ticket's first response is due: a target by priority, counted in business minutes, Monday
+  to Friday from 09:00 to 17:00 UTC.
+  """
+
+  alias Desk.Tickets.Ticket
+
+  @opens ~T[09:00:00]
+  @closes ~T[17:00:00]
+  @targets %{urgent: 60, high: 240, normal: 480, low: 1440}
+
+  def target_minutes(priority), do: Map.fetch!(@targets, priority)
+
+  def due_at(%Ticket{} = ticket),
+    do: add_business_minutes(ticket.inserted_at, target_minutes(ticket.priority))
+
+  def breached?(%Ticket{first_response_at: nil} = ticket, now),
+    do: DateTime.after?(now, due_at(ticket))
+
+  def breached?(%Ticket{first_response_at: answered} = ticket, _now),
+    do: DateTime.after?(answered, due_at(ticket))
+
+  @doc "The time `minutes` business minutes after `from`."
+  def add_business_minutes(%DateTime{} = from, minutes)
+      when is_integer(minutes) and minutes >= 0 do
+    from |> DateTime.shift_zone!("Etc/UTC") |> opening() |> add(minutes * 60)
+  end
+
+  # `at` if the desk is open then, else the next time it opens
+  defp opening(at) do
+    date = DateTime.to_date(at)
+    time = DateTime.to_time(at)
+
+    cond do
+      Date.day_of_week(date) > 5 -> next_morning(date)
+      Time.before?(time, @opens) -> DateTime.new!(date, @opens)
+      not Time.before?(time, @closes) -> next_morning(date)
+      true -> at
+    end
+  end
+
+  defp next_morning(date), do: opening(DateTime.new!(Date.add(date, 1), @opens))
+
+  # `at` is inside business hours. What fits before closing is added; the rest goes on from the
+  # next opening. Seconds that land exactly on closing stay there.
+  defp add(at, seconds) do
+    closing = DateTime.new!(DateTime.to_date(at), @closes)
+    left = DateTime.diff(closing, at)
+
+    if seconds <= left,
+      do: DateTime.add(at, seconds),
+      else: add(next_morning(DateTime.to_date(at)), seconds - left)
+  end
+end
diff --git a/lib/desk/staff.ex b/lib/desk/staff.ex
new file mode 100644
index 0000000..a16cc77
--- /dev/null
+++ b/lib/desk/staff.ex
@@ -0,0 +1,27 @@
+defmodule Desk.Staff do
+  @moduledoc "The agents who work the desk."
+
+  import Ecto.Query
+
+  alias Desk.Repo
+  alias Desk.Staff.Agent
+  alias Desk.Tickets
+
+  def create_agent(attrs), do: %Agent{} |> Agent.changeset(attrs) |> Repo.insert()
+
+  def get_agent!(id), do: Repo.get!(Agent, id)
+
+  def list_agents, do: Repo.all(from a in Agent, order_by: [asc: a.name, asc: a.id])
+
+  def list_active_agents,
+    do: Repo.all(from a in Agent, where: a.active, order_by: [asc: a.name, asc: a.id])
+
+  @doc "Take an agent off the desk, and off the tickets they were working."
+  def deactivate_agent(%Agent{} = agent) do
+    Repo.transact(fn ->
+      agent = agent |> Ecto.Changeset.change(active: false) |> Repo.update!()
+      Tickets.release(agent)
+      {:ok, agent}
+    end)
+  end
+end
diff --git a/lib/desk/staff/agent.ex b/lib/desk/staff/agent.ex
