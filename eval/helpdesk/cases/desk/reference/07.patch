+defmodule DeskWeb.TicketLive.New do
+  @moduledoc "File a ticket."
+  use DeskWeb, :live_view
+
+  alias Desk.Tickets
+  alias Desk.Tickets.Ticket
+
+  @impl true
+  def mount(_params, _session, socket) do
+    {:ok,
+     assign(socket,
+       form: to_form(Ticket.changeset(%Ticket{}, %{})),
+       priorities: Ticket.priorities()
+     )}
+  end
+
+  @impl true
+  def handle_event("save", %{"ticket" => attrs}, socket) do
+    case Tickets.create_ticket(attrs) do
+      {:ok, ticket} -> {:noreply, push_navigate(socket, to: ~p"/tickets/#{ticket.id}")}
+      {:error, changeset} -> {:noreply, assign(socket, form: to_form(changeset))}
+    end
+  end
+
+  @impl true
+  def render(assigns) do
+    ~H"""
+    <Layouts.app flash={@flash}>
+      <.header>New ticket</.header>
+
+      <.form for={@form} id="ticket-form" phx-submit="save">
+        <.input field={@form[:subject]} label="Subject" />
+        <.input field={@form[:body]} type="textarea" label="What is wrong" />
+        <.input field={@form[:requester_email]} label="Your email" />
+        <.input field={@form[:priority]} type="select" label="Priority" options={@priorities} />
+        <.button>File it</.button>
+      </.form>
+    </Layouts.app>
+    """
+  end
+end
diff --git a/lib/desk_web/live/ticket_live/show.ex b/lib/desk_web/live/ticket_live/show.ex
new file mode 100644
index 0000000..49a138d
--- /dev/null
+++ b/lib/desk_web/live/ticket_live/show.ex
@@ -0,0 +1,106 @@
+defmodule DeskWeb.TicketLive.Show do
+  @moduledoc "One ticket: where it stands, whose it is, and what has been said."
+  use DeskWeb, :live_view
+
+  alias Desk.Staff
+  alias Desk.Tickets
+
+  @impl true
+  def mount(%{"id" => id}, _session, socket) do
+    {:ok, socket |> assign(agents: Staff.list_active_agents()) |> shown(Tickets.get_ticket!(id))}
+  end
+
+  @impl true
+  def handle_event("transition", %{"to" => to}, socket) do
+    case Tickets.transition(socket.assigns.ticket, String.to_existing_atom(to)) do
+      {:ok, ticket} ->
+        {:noreply, shown(socket, ticket)}
+
+      {:error, :invalid_transition} ->
+        {:noreply, put_flash(socket, :error, "It cannot move there")}
+    end
+  end
+
+  def handle_event("auto-assign", _params, socket) do
+    case Tickets.auto_assign(socket.assigns.ticket) do
+      {:ok, ticket} -> {:noreply, shown(socket, ticket)}
+      {:error, :no_agents} -> {:noreply, put_flash(socket, :error, "No agent is active")}
+      {:error, :closed} -> {:noreply, put_flash(socket, :error, "The ticket is closed")}
+    end
+  end
+
+  def handle_event("comment", %{"comment" => attrs}, socket) do
+    case Tickets.add_comment(socket.assigns.ticket, Map.put(attrs, "author_kind", "agent")) do
+      {:ok, %{ticket: ticket}} ->
+        {:noreply, shown(socket, ticket)}
+
+      {:error, :closed} ->
+        {:noreply, put_flash(socket, :error, "The ticket is closed")}
+
+      {:error, _changeset} ->
+        {:noreply, put_flash(socket, :error, "A comment needs a body and an agent")}
+    end
+  end
+
+  defp shown(socket, ticket) do
+    assign(socket,
+      ticket: Desk.Repo.preload(ticket, :assignee, force: true),
+      moves: Tickets.allowed_transitions(ticket.status),
+      comments: Tickets.list_comments(ticket),
+      comment: to_form(%{"body" => "", "internal" => "false"}, as: :comment)
+    )
+  end
+
+  @impl true
+  def render(assigns) do
+    ~H"""
+    <Layouts.app flash={@flash}>
+      <.header>
+        {@ticket.subject}
+        <:subtitle>{@ticket.requester_email}, {@ticket.priority}</:subtitle>
+      </.header>
+
+      <p>Status: <span id="ticket-status">{@ticket.status}</span></p>
+      <p>
+        Assignee:
+        <span id="assignee">{if @ticket.assignee, do: @ticket.assignee.name, else: "Unassigned"}</span>
+        <button id="auto-assign" phx-click="auto-assign" class="btn">Assign it</button>
+      </p>
+
+      <p>{@ticket.body}</p>
+
+      <div id="transitions">
+        <button
+          :for={to <- @moves}
+          id={"transition-#{to}"}
+          phx-click="transition"
+          phx-value-to={to}
+          class="btn"
+        >
+          {to}
+        </button>
+      </div>
+
+      <ul id="comments">
+        <li :for={comment <- @comments} id={"comment-#{comment.id}"}>
+          <strong>{comment.author_kind}</strong>
+          <em :if={comment.internal}>internal</em>
+          {comment.body}
+        </li>
+      </ul>
+
+      <.form for={@comment} id="comment-form" phx-submit="comment">
+        <.input field={@comment[:body]} type="textarea" label="Comment" />
+        <.input
+          field={@comment[:agent_id]}
+          type="select"
+          label="As"
+          options={Enum.map(@agents, &{&1.name, &1.id})}
+        />
+        <.input field={@comment[:internal]} type="checkbox" label="A note between agents" />
+        <.button>Say it</.button>
+      </.form>
+    </Layouts.app>
+    """
+  end
+end
