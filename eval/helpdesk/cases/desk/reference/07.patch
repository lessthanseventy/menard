+++ b/lib/desk_web/live/ticket_live/index.ex
@@ -0,0 +1,55 @@
+defmodule DeskWeb.TicketLive.Index do
+  @moduledoc "The desk's tickets, narrowed by status."
+  use DeskWeb, :live_view
+
+  alias Desk.Tickets
+  alias Desk.Tickets.Ticket
+
+  @impl true
+  def mount(_params, _session, socket), do: {:ok, listed(socket, "")}
+
+  @impl true
+  def handle_event("filter", %{"status" => status}, socket),
+    do: {:noreply, listed(socket, status)}
+
+  defp listed(socket, status) do
+    opts = if status == "", do: [], else: [status: String.to_existing_atom(status)]
+
+    assign(socket,
+      status: status,
+      tickets: Tickets.list_tickets(opts),
+      statuses: Ticket.statuses()
+    )
+  end
+
+  @impl true
+  def render(assigns) do
+    ~H"""
+    <Layouts.app flash={@flash}>
+      <.header>
+        Tickets
+        <:actions>
+          <.link navigate={~p"/tickets/new"} class="btn btn-primary">New ticket</.link>
+        </:actions>
+      </.header>
+
+      <form id="filters" phx-change="filter">
+        <select name="status">
+          <option value="" selected={@status == ""}>All</option>
+          <option :for={status <- @statuses} value={status} selected={@status == "#{status}"}>
+            {status}
+          </option>
+        </select>
+      </form>
+
+      <ul id="tickets">
+        <li :for={ticket <- @tickets} id={"ticket-#{ticket.id}"}>
+          <.link navigate={~p"/tickets/#{ticket.id}"}>{ticket.subject}</.link>
+          <span>{ticket.priority}</span>
+          <span>{ticket.status}</span>
+        </li>
+      </ul>
+    </Layouts.app>
+    """
+  end
+end
