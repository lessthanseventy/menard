@@ -0,0 +1,17 @@
+defmodule Desk.Repo.Migrations.CreateTickets do
+  use Ecto.Migration
+
+  def change do
+    create table(:tickets) do
+      add :subject, :string, null: false
+      add :body, :text, null: false
+      add :requester_email, :string, null: false
+      add :priority, :string, null: false, default: "normal"
+      add :status, :string, null: false, default: "new"
+
+      timestamps(type: :utc_datetime)
+    end
+
+    create index(:tickets, [:status])
+  end
+end
diff --git a/priv/repo/migrations/20260301000002_status_flow.exs b/priv/repo/migrations/20260301000002_status_flow.exs
new file mode 100644
index 0000000..f1fd57e
--- /dev/null
+++ b/priv/repo/migrations/20260301000002_status_flow.exs
@@ -0,0 +1,21 @@
+defmodule Desk.Repo.Migrations.StatusFlow do
+  use Ecto.Migration
+
+  def change do
+    alter table(:tickets) do
+      add :resolved_at, :utc_datetime
+      add :closed_at, :utc_datetime
+    end
+
+    create table(:ticket_events) do
+      add :ticket_id, references(:tickets, on_delete: :delete_all), null: false
+      add :kind, :string, null: false
+      add :from, :string
+      add :to, :string
+
+      timestamps(type: :utc_datetime, updated_at: false)
+    end
+
+    create index(:ticket_events, [:ticket_id])
+  end
+end
