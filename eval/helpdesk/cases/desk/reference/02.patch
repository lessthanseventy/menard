+defmodule Desk.TicketsTest do
+  use Desk.DataCase, async: true
+
+  alias Desk.Tickets
+
+  test "a ticket is filed new" do
+    assert {:ok, ticket} =
+             Tickets.create_ticket(%{subject: "s", body: "b", requester_email: "a@b.c"})
+
+    assert ticket.status == :new
+  end
+end
