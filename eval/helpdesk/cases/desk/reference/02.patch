diff --git a/lib/desk/tickets.ex b/lib/desk/tickets.ex
new file mode 100644
index 0000000..a43c5bc
--- /dev/null
+++ b/lib/desk/tickets.ex
@@ -0,0 +1,89 @@
+defmodule Desk.Tickets do
+  @moduledoc "Tickets: filing them and finding them."
+
+  import Ecto.Query
+
+  alias Desk.Repo
+  alias Desk.Tickets.Event
+  alias Desk.Tickets.Ticket
+
+  @moves %{
+    new: [:open],
+    open: [:pending, :resolved],
+    pending: [:open, :resolved],
+    resolved: [:open, :closed],
+    closed: []
+  }
+
+  @doc "File a ticket. It starts new, whatever the attributes say."
+  def create_ticket(attrs) do
+    Repo.transact(fn ->
+      with {:ok, ticket} <- %Ticket{} |> Ticket.changeset(attrs) |> Repo.insert() do
+        record(ticket, "created", nil, "new")
+        {:ok, ticket}
+      end
+    end)
+  end
+
+  def get_ticket!(id), do: Repo.get!(Ticket, id)
+
+  @doc """
+  Tickets, the most urgent first and the oldest first within a priority. `opts` narrows the list:
+  `status:` and `priority:`.
+  """
+  def list_tickets(opts \\ []) do
+    Ticket
+    |> narrow(opts)
+    |> order_by([t],
+      asc:
+        fragment(
+          "CASE ? WHEN 'urgent' THEN 0 WHEN 'high' THEN 1 WHEN 'normal' THEN 2 ELSE 3 END",
+          t.priority
+        ),
+      asc: t.inserted_at,
+      asc: t.id
+    )
+    |> Repo.all()
+  end
+
+  defp narrow(query, opts) do
+    Enum.reduce(opts, query, fn
+      {:status, status}, query -> where(query, [t], t.status == ^status)
+      {:priority, priority}, query -> where(query, [t], t.priority == ^priority)
+    end)
+  end
+
+  @doc "The statuses a ticket in `status` may move to."
+  def allowed_transitions(status), do: Map.fetch!(@moves, status)
+
+  @doc "Move a ticket, if the flow allows the move."
+  def transition(%Ticket{status: from} = ticket, to) do
+    if to in allowed_transitions(from), do: move(ticket, to), else: {:error, :invalid_transition}
+  end
+
+  def list_events(%Ticket{id: id}) do
+    Repo.all(
+      from e in Event, where: e.ticket_id == ^id, order_by: [asc: e.inserted_at, asc: e.id]
+    )
+  end
+
+  # the move itself, with its times and its event: whether it may be made is the caller's to say
+  defp move(%Ticket{status: from} = ticket, to) do
+    Repo.transact(fn ->
+      ticket = ticket |> Ecto.Changeset.change([status: to] ++ times(to)) |> Repo.update!()
+      record(ticket, "status", Atom.to_string(from), Atom.to_string(to))
+      {:ok, ticket}
+    end)
+  end
+
+  defp times(:resolved), do: [resolved_at: now()]
+  defp times(:closed), do: [closed_at: now()]
+  defp times(:open), do: [resolved_at: nil]
+  defp times(_status), do: []
+
+  defp now, do: DateTime.utc_now(:second)
+
+  defp record(ticket, kind, from, to) do
+    Repo.insert!(%Event{ticket_id: ticket.id, kind: kind, from: from, to: to})
+  end
+end
diff --git a/lib/desk/tickets/event.ex b/lib/desk/tickets/event.ex
new file mode 100644
index 0000000..455f96c
--- /dev/null
+++ b/lib/desk/tickets/event.ex
@@ -0,0 +1,14 @@
+defmodule Desk.Tickets.Event do
+  @moduledoc "One thing that happened to a ticket: it was filed, it moved, it changed hands."
+  use Ecto.Schema
+
+  schema "ticket_events" do
+    field :kind, :string
+    field :from, :string
+    field :to, :string
+
+    belongs_to :ticket, Desk.Tickets.Ticket
+
+    timestamps(type: :utc_datetime, updated_at: false)
+  end
+end
diff --git a/lib/desk/tickets/ticket.ex b/lib/desk/tickets/ticket.ex
new file mode 100644
index 0000000..2aa6da4
--- /dev/null
+++ b/lib/desk/tickets/ticket.ex
@@ -0,0 +1,35 @@
+defmodule Desk.Tickets.Ticket do
+  @moduledoc "A request for help: who asked, what for, how urgent, and where it stands."
+  use Ecto.Schema
+
+  import Ecto.Changeset
+
+  @priorities [:low, :normal, :high, :urgent]
+  @statuses [:new, :open, :pending, :resolved, :closed]
+
+  schema "tickets" do
+    field :subject, :string
+    field :body, :string
+    field :requester_email, :string
+    field :priority, Ecto.Enum, values: @priorities, default: :normal
+    field :status, Ecto.Enum, values: @statuses, default: :new
+    field :resolved_at, :utc_datetime
+    field :closed_at, :utc_datetime
+
+    timestamps(type: :utc_datetime)
+  end
+
+  def priorities, do: @priorities
+  def statuses, do: @statuses
+
+  @doc "A new ticket's changeset: its status is not the caller's to set."
+  def changeset(ticket, attrs) do
+    ticket
+    |> cast(attrs, [:subject, :body, :requester_email, :priority])
+    |> update_change(:subject, &String.trim/1)
+    |> update_change(:requester_email, &(&1 |> String.trim() |> String.downcase()))
+    |> validate_required([:subject, :body, :requester_email])
+    |> validate_length(:subject, max: 120)
+    |> validate_format(:requester_email, ~r/^[^\s@]+@[^\s@]+$/)
+  end
+end
diff --git a/priv/repo/migrations/20260301000001_create_tickets.exs b/priv/repo/migrations/20260301000001_create_tickets.exs
