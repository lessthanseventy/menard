+
+  schema "ticket_events" do
+    field :kind, :string
+    field :from, :string
+    field :to, :string
+
+    belongs_to :ticket, Desk.Tickets.Ticket
+
+    timestamps(type: :utc_datetime, updated_at: false)
+  end
+end
diff --git a/lib/desk/tickets/ticket.ex b/lib/desk/tickets/ticket.ex
new file mode 100644
index 0000000..2d86daa
--- /dev/null
+++ b/lib/desk/tickets/ticket.ex
@@ -0,0 +1,38 @@
+defmodule Desk.Tickets.Ticket do
+  @moduledoc "A request for help: who asked, what for, how urgent, and where it stands."
+  use Ecto.Schema
+
+  import Ecto.Changeset
+
+  @priorities [:low, :normal, :high, :urgent]
+  @statuses [:new, :open, :pending, :resolved, :closed]
+
+  schema "tickets" do
+    field :subject, :string
+    field :body, :string
+    field :requester_email, :string
+    field :priority, Ecto.Enum, values: @priorities, default: :normal
+    field :status, Ecto.Enum, values: @statuses, default: :new
+    field :resolved_at, :utc_datetime
+    field :closed_at, :utc_datetime
+    field :first_response_at, :utc_datetime
+
+    belongs_to :assignee, Desk.Staff.Agent
+
+    timestamps(type: :utc_datetime)
+  end
+
+  def priorities, do: @priorities
+  def statuses, do: @statuses
+
+  @doc "A new ticket's changeset: its status is not the caller's to set."
+  def changeset(ticket, attrs) do
+    ticket
+    |> cast(attrs, [:subject, :body, :requester_email, :priority])
+    |> update_change(:subject, &String.trim/1)
+    |> update_change(:requester_email, &(&1 |> String.trim() |> String.downcase()))
+    |> validate_required([:subject, :body, :requester_email])
+    |> validate_length(:subject, max: 120)
+    |> validate_format(:requester_email, ~r/^[^\s@]+@[^\s@]+$/)
+  end
+end
