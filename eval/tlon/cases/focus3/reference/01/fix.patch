+    test "keeps a match however low it scores: initials far down a long path still find it" do
+      assert Fuzzy.match("Machine · Tlön · rail redesign", "rr") < 0
+      assert Fuzzy.filter(["Machine · Tlön · rail redesign"], "rr") == ["Machine · Tlön · rail redesign"]
+      assert Fuzzy.filter(["Machine · Tlön · rail redesign"], "r") == ["Machine · Tlön · rail redesign"]
+    end
+  end
