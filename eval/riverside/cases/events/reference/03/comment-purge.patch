diff --git a/lib/ex_riverside/events/calendar.ex b/lib/ex_riverside/events/calendar.ex
new file mode 100644
index 0000000..89a6cd4
--- /dev/null
+++ b/lib/ex_riverside/events/calendar.ex
@@ -0,0 +1,50 @@
+defmodule ExRiverside.Events.Calendar do
+  @moduledoc """
+  An event as an iCalendar (RFC 5545) file: one VCALENDAR holding one VEVENT, times in UTC, text
+  values escaped.
+  """
+
+  alias ExRiverside.Events.Event
+
+  @doc "The .ics body for `event`, CRLF line ends."
+  def ics(%Event{} = event) do
+    lines =
+      [
+        "BEGIN:VCALENDAR",
+        "VERSION:2.0",
+        "PRODID:-//ExRiverside//Events//EN",
+        "BEGIN:VEVENT",
+        "UID:event-#{event.id}@riverside",
+        "DTSTAMP:#{stamp(DateTime.utc_now())}",
+        "DTSTART:#{stamp(event.starts_at)}"
+      ] ++
+        optional("DTEND", event.ends_at && stamp(event.ends_at)) ++
+        [
+          "SUMMARY:#{escape(event.title)}",
+          "DESCRIPTION:#{escape(event.description || "")}"
+        ] ++
+        optional("LOCATION", Event.location_name(event) && escape(Event.location_name(event))) ++
+        [
+          "URL:#{ExRiversideWeb.Endpoint.url()}/events/#{event.id}",
+          "END:VEVENT",
+          "END:VCALENDAR"
+        ]
+
+    Enum.map_join(lines, "", &(&1 <> "\r\n"))
+  end
+
+  defp optional(_name, nil), do: []
+  defp optional(name, value), do: ["#{name}:#{value}"]
+
+  defp stamp(%DateTime{} = at) do
+    at |> DateTime.truncate(:second) |> Calendar.strftime("%Y%m%dT%H%M%SZ")
+  end
+
+  defp escape(text) do
+    text
+    |> String.replace("\\", "\\\\")
+    |> String.replace(";", "\\;")
+    |> String.replace(",", "\\,")
+    |> String.replace(~r/\r?\n/, "\\n")
+  end
+end
diff --git a/lib/ex_riverside_web/controllers/event_calendar_controller.ex b/lib/ex_riverside_web/controllers/event_calendar_controller.ex
