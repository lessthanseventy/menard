+++ b/lib/ex_riverside_web/controllers/event_calendar_controller.ex
@@ -0,0 +1,20 @@
+defmodule ExRiversideWeb.EventCalendarController do
+  @moduledoc "The \"Add to calendar\" file of a live event."
+  use ExRiversideWeb, :controller
+
+  alias ExRiverside.Events
+  alias ExRiverside.Events.Calendar
+
+  def show(conn, %{"id" => id}) do
+    event = Events.get_event!(id)
+
+    if event.status in [:published, :ongoing] do
+      conn
+      |> put_resp_content_type("text/calendar")
+      |> put_resp_header("content-disposition", ~s(attachment; filename="event-#{event.id}.ics"))
+      |> send_resp(200, Calendar.ics(event))
+    else
+      raise Ecto.NoResultsError, queryable: ExRiverside.Events.Event
+    end
+  end
+end
